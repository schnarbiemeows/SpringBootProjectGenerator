<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="30">
	<Properties>
		<Property name="LOG_PATTERN">
			PATTERN_CONFIG
		</Property>
	</Properties>
	<Appenders>
		<Console name="ConsoleAppender" target="SYSTEM_OUT"
			follow="true">
			<PatternLayout pattern="${LOG_PATTERN}" />
		</Console>
		<RollingFile name="FileAppender"
			fileName="ABS_FILE_NAME.log"
			filePattern="ABS_FILE_NAME-%d{yyyy-MM-dd}-%i.log">
			<PatternLayout>
				<Pattern>${LOG_PATTERN}</Pattern>
			</PatternLayout>
			<Policies>
				<SizeBasedTriggeringPolicy size="LOG_SIZEMB" />
			</Policies>
			<DefaultRolloverStrategy max="MAX_LOG_FILES" />
		</RollingFile>
	</Appenders>
	<Loggers>
		<Logger name="com.example.log4j2demo" level="debug"
			additivity="false">
			<AppenderRef ref="ConsoleAppender" />
		</Logger>
		<Logger name="FileAppender" level="debug" additivity="false">
			<AppenderRef ref="FileAppender" />
		</Logger>
		<Root level="info">
			<AppenderRef ref="ConsoleAppender" />
			<!-- <AppenderRef ref="FileAppender" /> -->
		</Root>
	</Loggers>
</Configuration>